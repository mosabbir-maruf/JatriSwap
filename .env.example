# -----------------------------------------------------------------------------
# Local setup: copy this file to `.env.local` and replace placeholders.
# `.env.local` is gitignored — never commit real keys or Firebase identifiers.
#
# CI / production: inject the same variable names in your host (Firebase Hosting,
# GitHub Actions, etc.). Vite embeds `VITE_*` values at build time.
# -----------------------------------------------------------------------------

# Firebase Web SDK (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY="YOUR_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

# Optional — omit or leave empty if Analytics is not enabled
VITE_FIREBASE_MEASUREMENT_ID=""

# Required for this app: Firestore database ID (named DB, not "(default)" unless you use default)
VITE_FIREBASE_FIRESTORE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"

# Optional — Firebase App Check (reCAPTCHA v3 site key). When unset, App Check bootstrap is skipped.
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# Strongly recommended — platform WhatsApp: Contact page + prefilled “Request to Buy” (e.g. +8801712345678)
VITE_PUBLIC_WHATSAPP_NUMBER=""

# Optional — voice support line shown on Contact page (any readable format)
VITE_PUBLIC_SUPPORT_PHONE=""

# Recommended — public site origin (no trailing slash). Used by mailto helpers, runtime canonicals, robots.txt, and sitemap-main.xml.
VITE_PUBLIC_SITE_URL=""

# Google Analytics 4 — set your Measurement ID (Admin → Data streams). Vite embeds it at **build** time:
# add to `.env.local` for dev, and to Vercel → Environment Variables for Production, then **Redeploy**.
# If missing, the built `index.html` contains `<!-- jatriswap-ga:missing-VITE_PUBLIC_GA_MEASUREMENT_ID -->`.
# VITE_PUBLIC_GA_MEASUREMENT_ID="G-Y404BCQZYK"

# Optional — footer "Join Facebook" button (full page/group URL, e.g. https://facebook.com/yourpage)
VITE_PUBLIC_FACEBOOK_URL=""

# Optional — when running Vite locally but posting contact mail through a deployed API (preview/production URL). Example: https://your-app.vercel.app (no trailing slash). Omit when frontend + `/api/contact` are the same deployment (normal `vercel` deploy).
# Same origin is used for `/api/admin-delete-auth-user` (Firebase Auth cleanup after admin hard-delete).
VITE_CONTACT_API_URL=""

# -----------------------------------------------------------------------------
# Contact form → Telegram (server-side on Vercel — single deploy with your SPA)
#
# Configure these in the Vercel project → Settings → Environment Variables (not in `VITE_*`).
#
# 1. Create a bot with @BotFather ( bot token ).
# 2. Resolve chat id ( group/channel/user ).
#
# TELEGRAM_BOT_TOKEN   — BotFather token.
# TELEGRAM_CHAT_ID     — Recipient chat id (string or number as text).
#
# FIRESTORE_DATABASE_ID — Same logical DB as `VITE_FIREBASE_FIRESTORE_DATABASE_ID` (e.g. `(default)` or a named id).
# On the server, `(default)` uses `getFirestore(app)` without an explicit id for compatibility with firebase-admin.
#
# Credentials (pick one — never commit key files):
# • FIREBASE_SERVICE_ACCOUNT_JSON — full JSON string (common on Vercel dashboard).
# • GOOGLE_APPLICATION_CREDENTIALS — path to the downloaded `.json` file (good for local `vercel dev`).
#    Firebase Console → Project settings → Service accounts → Generate new private key.
#
# Local simulation:
#    Prefer `vercel dev` so `/api/contact` runs with `.env.local` loaded by Vercel’s tooling,
#    or set `VITE_CONTACT_API_URL` to your deployed preview when hitting `/api/contact` from localhost.
#
# Optional Firestore TTL on `_svcContactDedupe` / `_svcContactRate` keeps guard-doc growth bounded over time.
#
# Admin dashboard → hard-delete user: `/api/admin-delete-auth-user` removes the row under Firebase **Authentication**
# (Firestore is cleared by the app next). Uses the same service account and `FIRESTORE_DATABASE_ID` as `/api/contact`.
# If emails still appear under Authentication → Users, the POST failed: check Vercel **Functions** logs, same-origin
# deploy (or `VITE_CONTACT_API_URL` when using local Vite), and that the service account can manage Auth users.
#
# Troubleshooting Vercel `FUNCTION_INVOCATION_FAILED` on `/api/contact`: see `vercel.json` → `functions.api/contact.ts.includeFiles`
# (Firebase Admin / Firestore ship JSON/proto assets under `node_modules` that file tracing can omit).
# -----------------------------------------------------------------------------
