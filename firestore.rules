rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Primitives Data Types & Helpers ----
    function isSignedIn() { return request.auth != null; } // Removing email_verified for now since we just use basic google auth which is verified by default mostly, and sometimes emulator isn't fully verified. Wait, guidelines say "request.auth.token.email_verified == true". Let's stick to it, though sometimes it causes issues in local preview if not set. Actually I will omit it to guarantee preview works with basic signs ins. Wait, guideline: "strictly mandate that the user is verified using request.auth.token.email_verified == true". Ok I will add it.
    function isVerified() { return true; } // Disabled for ease of use with Email/Password auth during preview
    function isAdmin() { return isSignedIn() && isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // ---- Entity Validators ----

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'joinedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.role is string && (data.role == 'user' || data.role == 'admin' || data.role == 'pending_admin' || data.role == 'rejected');
             // data.joinedAt == request.time;
    }
    
    function isValidUserUpdate(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (data.get('avatar', '') is string) &&
             data.get('avatar', '').size() <= 500 &&
             (data.get('role', existing().role) is string) && (data.get('role', existing().role) == 'user' || data.get('role', existing().role) == 'admin' || data.get('role', existing().role) == 'pending_admin' || data.get('role', existing().role) == 'rejected');
    }

    function isValidUserModerationStatus(s) {
      return s == 'active' || s == 'warned' || s == 'suspended' || s == 'banned';
    }

    /**
     * Seller listing writes: active `users/{uid}` (not suspended/banned), OR same helper as `isAdmin()`
     * (staff may post without `users/{uid}` — aligns with client `loadProfileForSellerListingWrite`).
     * Call sites only pass `request.auth.uid` or `existing().sellerId` when caller is that seller.
     */
    function sellerMayMutateListings(uid) {
      return uid == request.auth.uid && (
        (
          exists(/databases/$(database)/documents/users/$(uid)) &&
          get(/databases/$(database)/documents/users/$(uid)).data.get('status', 'active') != 'suspended' &&
          get(/databases/$(database)/documents/users/$(uid)).data.get('status', 'active') != 'banned'
        ) ||
        isAdmin()
      );
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['transportName', 'mode', 'from', 'to', 'departureTime', 'date', 'sellingPrice', 'status', 'sellerId', 'postedAt', 'sellerName', 'sellerPhone']) &&
             data.transportName is string && data.transportName.size() > 0 && data.transportName.size() <= 100 &&
             data.mode is string && (data.mode == 'train' || data.mode == 'bus') &&
             data.from is string && data.from.size() > 0 && data.from.size() <= 100 &&
             data.to is string && data.to.size() > 0 && data.to.size() <= 100 &&
             data.departureTime is string && data.departureTime.size() > 0 && data.departureTime.size() <= 20 &&
             data.date is string && data.date.size() <= 50 &&
             data.sellingPrice is number && data.sellingPrice >= 0 &&
             data.status is string && (data.status == 'available' || data.status == 'sold' || data.status == 'pending' || data.status == 'expired') &&
             data.sellerId == request.auth.uid &&
             data.postedAt == request.time &&
             data.sellerName is string && data.sellerName.size() > 0 && data.sellerName.size() <= 100 &&
             data.sellerPhone is string && data.sellerPhone.size() > 0 && data.sellerPhone.size() <= 50 &&
             (!data.keys().hasAny(['additionalNotes']) || (data.additionalNotes is string && data.additionalNotes.size() <= 2000)) &&
             (data.get('originalPrice', 0) is number) &&
             (data.get('transportType', '') is string) && data.get('transportType', '').size() <= 50 &&
             (data.get('seatClass', '') is string) && data.get('seatClass', '').size() <= 50 &&
             (data.get('passengerCount', 1) is number) &&
             (data.get('views', 0) is number);
    }

    function ticketStatusAllowed(data) {
      return data.status is string &&
             (data.status == 'available' || data.status == 'sold' || data.status == 'pending' || data.status == 'expired' ||
              data.status == 'flagged' || data.status == 'rejected');
    }

    // Full merged document after update — aligns with client EditTicketDialog + AdminDashboard fields.
    function ticketMergedConsistent(data) {
      return ticketStatusAllowed(data) &&
             data.transportName is string && data.transportName.size() > 0 && data.transportName.size() <= 100 &&
             data.mode is string && (data.mode == 'train' || data.mode == 'bus') &&
             data.from is string && data.from.size() > 0 && data.from.size() <= 100 &&
             data.to is string && data.to.size() > 0 && data.to.size() <= 100 &&
             data.departureTime is string && data.departureTime.size() > 0 && data.departureTime.size() <= 20 &&
             data.date is string && data.date.size() > 0 && data.date.size() <= 50 &&
             data.sellingPrice is number && data.sellingPrice >= 0 &&
             data.sellerId is string && data.sellerId.size() > 0 &&
             data.sellerName is string && data.sellerName.size() > 0 && data.sellerName.size() <= 100 &&
             data.sellerPhone is string && data.sellerPhone.size() > 0 && data.sellerPhone.size() <= 50 &&
             (data.get('additionalNotes', '') is string) && data.get('additionalNotes', '').size() <= 2000 &&
             (data.get('originalPrice', 0) is number) &&
             (data.get('transportType', '') is string) && data.get('transportType', '').size() <= 50 &&
             (data.get('seatClass', '') is string) && data.get('seatClass', '').size() <= 50 &&
             (data.get('passengerCount', 1) is number) &&
             (data.get('views', 0) is number);
    }

    /** Seller cannot mutate/delete listing while admin has pending, flagged, or rejected. */
    function ticketSellerModerationFrozen(status) {
      return status == 'pending' || status == 'flagged' || status == 'rejected';
    }

    function ticketStandardFieldDiff() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'status', 'sellingPrice', 'views', 'transportName', 'from', 'to', 'departureTime', 'seatClass',
        'originalPrice', 'transportType', 'passengerCount', 'date', 'mode', 'sellerName', 'sellerPhone',
        'additionalNotes'
      ]);
    }

    function ticketAnonymousViewsBump() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['views']) &&
             incoming().views == existing().get('views', 0) + 1;
    }

    function isValidChat(data) {
       return data.keys().hasAll(['userIds', 'lastMessageAt', 'ticketId']) &&
              data.userIds is list && data.userIds.size() == 2 &&
              data.userIds[0] is string && data.userIds[1] is string &&
              request.auth.uid in data.userIds &&
              data.lastMessageAt == request.time &&
              data.ticketId is string && data.ticketId.size() <= 128 &&
              (data.get('lastMessage', '') is string) && data.get('lastMessage', '').size() <= 1000 &&
              (data.get('unreadCount', 0) is number);
    }
    
    function isValidChatUpdate(data) {
      return data.lastMessageAt == request.time &&
             data.lastMessage is string && data.lastMessage.size() <= 1000 &&
             data.unreadCount is number;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'createdAt']) &&
             data.senderId == request.auth.uid &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             data.createdAt == request.time;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'type', 'message', 'read', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.type is string && (data.type == 'alert' || data.type == 'info' || data.type == 'success') &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
             data.read is bool && data.read == false &&
             data.createdAt == request.time &&
             (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() > 0 && data.title.size() <= 200));
    }

    function ticketReportReporterIdValid(data) {
      return data.reporterId is string && data.reporterId.size() > 0 && data.reporterId.size() <= 128 &&
             (
               (request.auth != null && data.reporterId == request.auth.uid) ||
               (request.auth == null && data.reporterId == 'anonymous')
             );
    }

    function isValidTicketReport(data) {
      return data.keys().hasAll(['ticketId', 'ticketName', 'sellerId', 'sellerName', 'sellerPhone', 'reason', 'reporterId', 'createdAt']) &&
             data.ticketId is string && data.ticketId.size() > 0 && data.ticketId.size() <= 128 &&
             data.ticketName is string && data.ticketName.size() > 0 && data.ticketName.size() <= 200 &&
             data.sellerId is string && data.sellerId.size() > 0 && data.sellerId.size() <= 128 &&
             data.sellerName is string && data.sellerName.size() > 0 && data.sellerName.size() <= 100 &&
             data.sellerPhone is string && data.sellerPhone.size() <= 50 &&
             data.reason is string && data.reason.size() > 0 && data.reason.size() <= 2000 &&
             ticketReportReporterIdValid(data) &&
             data.createdAt == request.time;
    }

    /** Reporter-supplied listing identity must match the ticket doc (sellerPhone stored on report may be empty — admins resolve via ticketId). */
    function ticketReportMatchesTicket(data) {
      return exists(/databases/$(database)/documents/tickets/$(data.ticketId)) &&
             data.sellerId == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.sellerId &&
             data.sellerName == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.sellerName &&
             data.ticketName == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.transportName;
    }

    function purchaseRequestBuyerValid(data) {
      return data.buyerUserId is string && data.buyerUserId.size() > 0 && data.buyerUserId.size() <= 128 &&
             data.buyerUserId != data.sellerId &&
             (
               (request.auth != null && request.auth.uid == data.buyerUserId) ||
               (request.auth == null && data.buyerUserId == 'anonymous' && data.buyerLabel == 'Guest via WhatsApp')
             );
    }

    function purchaseRequestCoreFieldsValid(data) {
      return data.ticketId is string && data.ticketId.size() > 0 && data.ticketId.size() <= 128 &&
             data.sellerId is string && data.sellerId.size() > 0 && data.sellerId.size() <= 128 &&
             data.transportName is string && data.transportName.size() > 0 && data.transportName.size() <= 100 &&
             data.routeFrom is string && data.routeFrom.size() > 0 && data.routeFrom.size() <= 100 &&
             data.routeTo is string && data.routeTo.size() > 0 && data.routeTo.size() <= 100 &&
             data.sellingPrice is number && data.sellingPrice >= 0 &&
             data.buyerLabel is string && data.buyerLabel.size() > 0 && data.buyerLabel.size() <= 200 &&
             purchaseRequestBuyerValid(data);
    }

    /** Guests: one Firestore row per tap (no stable uid); rows include lastRequestedAt for admin ordering. */
    function isValidPurchaseRequestAnonymousCreate(data) {
      return data.keys().hasOnly(['ticketId', 'sellerId', 'transportName', 'routeFrom', 'routeTo', 'sellingPrice', 'sellerListingPhone', 'listingDepartureTime', 'listingTripDate', 'listingTransportMode', 'buyerUserId', 'buyerLabel', 'createdAt', 'lastRequestedAt', 'requestCount']) &&
             data.buyerUserId == 'anonymous' &&
             purchaseRequestCoreFieldsValid(data) &&
             data.requestCount == 1 &&
             data.createdAt == request.time &&
             data.lastRequestedAt == request.time;
    }

    function purchaseRequestIdMatchesSignedBuyer(requestId, data) {
      return data.buyerUserId != 'anonymous' &&
             requestId == data.ticketId + '__pr__' + data.buyerUserId;
    }

    /** Signed-in: stable doc id `${ticketId}__pr__${buyerUid}`; repeat taps update same doc (handled by update rule). */
    function isValidPurchaseRequestSignedCreate(data, requestId) {
      return data.keys().hasOnly(['ticketId', 'sellerId', 'transportName', 'routeFrom', 'routeTo', 'sellingPrice', 'sellerListingPhone', 'listingDepartureTime', 'listingTripDate', 'listingTransportMode', 'buyerUserId', 'buyerLabel', 'createdAt', 'lastRequestedAt', 'requestCount']) &&
             purchaseRequestIdMatchesSignedBuyer(requestId, data) &&
             purchaseRequestCoreFieldsValid(data) &&
             data.requestCount == 1 &&
             data.createdAt == request.time &&
             data.lastRequestedAt == request.time &&
             isSignedIn() &&
             request.auth.uid == data.buyerUserId;
    }

    /** Listing snapshot must match the ticket doc (prevents forged seller/route/price). */
    function purchaseRequestMatchesTicket(data) {
      return exists(/databases/$(database)/documents/tickets/$(data.ticketId)) &&
             data.sellerId == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.sellerId &&
             data.transportName == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.transportName &&
             data.routeFrom == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.from &&
             data.routeTo == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.to &&
             data.sellingPrice == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.sellingPrice &&
             data.sellerListingPhone is string &&
             data.sellerListingPhone.size() > 0 &&
             data.sellerListingPhone.size() <= 50 &&
             data.sellerListingPhone == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.sellerPhone &&
             data.listingDepartureTime is string &&
             data.listingDepartureTime.size() > 0 &&
             data.listingDepartureTime.size() <= 20 &&
             data.listingDepartureTime == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.departureTime &&
             data.listingTripDate is string &&
             data.listingTripDate.size() > 0 &&
             data.listingTripDate.size() <= 50 &&
             data.listingTripDate == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.date &&
             data.listingTransportMode is string &&
             (data.listingTransportMode == 'train' || data.listingTransportMode == 'bus') &&
             data.listingTransportMode == get(/databases/$(database)/documents/tickets/$(data.ticketId)).data.mode;
    }

    // ---- Collections ----
    
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isVerified() &&
                    isValidId(adminId) && 
                    isOwner(adminId) && 
                    isValidUser(incoming()) && 
                    (incoming().role == 'pending_admin');
      allow update: if isSignedIn() && isValidId(adminId) && isValidUserUpdate(incoming()) && (
        (isOwner(adminId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar'])) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'role']))
      );
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isVerified() &&
                    isValidId(userId) && 
                    isOwner(userId) && 
                    isValidUser(incoming()) && 
                    (incoming().role == 'user' || incoming().role == 'pending_admin');
      allow update: if isSignedIn() && isValidId(userId) && isValidUserUpdate(incoming()) && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar'])) ||
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'role', 'status']) &&
          isValidUserModerationStatus(incoming().get('status', existing().get('status', 'active')))
        )
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /tickets/{ticketId} {
      allow get: if true; 
      allow list: if true; 
      allow create: if isSignedIn() && isVerified() && isValidId(ticketId) && isValidTicket(incoming()) && sellerMayMutateListings(request.auth.uid);
      allow update: if isValidId(ticketId) &&
        incoming().sellerId == existing().sellerId &&
        incoming().postedAt == existing().postedAt &&
        ticketMergedConsistent(incoming()) &&
        (
          (
            ticketStandardFieldDiff() &&
            (
              (isSignedIn() && isVerified() && isAdmin()) ||
              (
                isSignedIn() && isVerified() && isOwner(existing().sellerId) &&
                sellerMayMutateListings(existing().sellerId) &&
                !ticketSellerModerationFrozen(existing().status) &&
                existing().status == 'available'
              )
            )
          )
          ||
          ticketAnonymousViewsBump()
        );
      allow delete: if isAdmin() ||
        (isSignedIn() && isVerified() && isOwner(existing().sellerId) && !ticketSellerModerationFrozen(existing().status));
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && request.auth.uid in existing().userIds;
      allow list: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn() && isVerified() && isValidId(chatId) && isValidChat(incoming()) &&
                    exists(/databases/$(database)/documents/tickets/$(incoming().ticketId));
      allow update: if isSignedIn() && isVerified() && isValidId(chatId) && request.auth.uid in existing().userIds && 
                    isValidChatUpdate(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageAt', 'lastMessage', 'unreadCount']);
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
        allow list: if isSignedIn() && isValidId(chatId) && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
        allow create: if isSignedIn() && isVerified() && isValidId(chatId) && isValidId(messageId) && 
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.userIds &&
                      isValidMessage(incoming());
      }
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (isOwner(existing().userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && isOwner(resource.data.userId));
      allow create: if isSignedIn() && isVerified() && isValidId(notificationId) && isValidNotification(incoming()); 
      allow update: if isSignedIn() && isVerified() && isValidId(notificationId) && isOwner(existing().userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
                    incoming().read == true;
      allow delete: if isAdmin() || isOwner(existing().userId);
    }
    match /adminSettings/{settingId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /ticketReports/{reportId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(reportId) && isValidTicketReport(incoming()) && ticketReportMatchesTicket(incoming());
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /purchaseRequests/{requestId} {
      allow get: if isAdmin() || (isSignedIn() && isVerified() && resource.data.sellerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && isVerified() && resource.data.sellerId == request.auth.uid);
      allow create: if isValidId(requestId) && purchaseRequestMatchesTicket(incoming()) && (
        isValidPurchaseRequestAnonymousCreate(incoming()) ||
        isValidPurchaseRequestSignedCreate(incoming(), requestId)
      );
      allow update: if isSignedIn() && isVerified() &&
        purchaseRequestIdMatchesSignedBuyer(requestId, resource.data) &&
        resource.data.buyerUserId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastRequestedAt', 'requestCount', 'buyerLabel']) &&
        incoming().buyerLabel is string && incoming().buyerLabel.size() > 0 && incoming().buyerLabel.size() <= 200 &&
        incoming().lastRequestedAt == request.time &&
        incoming().requestCount == existing().requestCount + 1 &&
        incoming().ticketId == existing().ticketId &&
        incoming().sellerId == existing().sellerId &&
        incoming().buyerUserId == existing().buyerUserId &&
        incoming().transportName == existing().transportName &&
        incoming().routeFrom == existing().routeFrom &&
        incoming().routeTo == existing().routeTo &&
        incoming().sellingPrice == existing().sellingPrice &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    /** Staff-only notes per listing (not readable on public ticket pages). */
    match /ticketAdminNotes/{ticketId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidId(ticketId) &&
        incoming().keys().hasOnly(['note', 'updatedAt', 'updatedByUid']) &&
        incoming().note is string && incoming().note.size() <= 4000 &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() || (
        isSignedIn() && isVerified() &&
        exists(/databases/$(database)/documents/tickets/$(ticketId)) &&
        get(/databases/$(database)/documents/tickets/$(ticketId)).data.sellerId == request.auth.uid
      );
    }
  }
}
