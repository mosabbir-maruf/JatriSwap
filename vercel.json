{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/contact.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "api/lib/**"
    },
    "api/admin-delete-auth-user.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "api/lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
