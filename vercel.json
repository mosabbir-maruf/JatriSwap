{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/contact.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "{shared/**,node_modules/firebase-admin/**,node_modules/google-gax/**,node_modules/@google-cloud/firestore/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
